APP_NAME=Inkwell API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://inkwell:inkwell@localhost:5432/inkwell
TEST_DATABASE_URL=postgresql+psycopg://inkwell_test:inkwell_test@localhost:5433/inkwell_test
DATABASE_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=inkwell-api
JWT_AUDIENCE=inkwell-client
LOGIN_RATE_LIMIT_EMAIL_FAILURES=5
LOGIN_RATE_LIMIT_IP_FAILURES=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOG_LEVEL=INFO
