# Copy to .env.production on the server. Do not commit real secrets.
# Generate POSTGRES_PASSWORD and JWT_SECRET_KEY as separate random hex strings.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
CORS_ORIGINS=["https://useinkwell.vercel.app"]
VOICE_INTERVIEW_PROVIDER=openai_live
CONSULTANT_ENABLED=true
# Model IDs default to app/core/config.py. Override here as needed for your account.
